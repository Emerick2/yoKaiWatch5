    typeObjet: 0
  - "Id\xC9l\xE9ment": 0
    type: 0
    phrase: 'AH AH ! '
    quiJeSuis: 1
    nom: Kapakap
    image: {fileID: 21300000, guid: 2b0215a72b8be58439df6297910b5ca7, type: 3}
    "quantit\xE9e": 0
    typeObjet: 0
  - "Id\xC9l\xE9ment": 0
    type: 0
    phrase: Vraiment ?
    quiJeSuis: 2
    nom: <PNAME>
    image: {fileID: 21300000, guid: f8bfc68c5c493e9488e92fafb82c386b, type: 3}
    "quantit\xE9e": 0
    typeObjet: 0
  - "Id\xC9l\xE9ment": 0
    type: 0
    phrase: La je n'ai ni nom, ni image, tu en pense quoi <PNAME> ?
    quiJeSuis: 0
    nom: 
    image: {fileID: 0}
    "quantit\xE9e": 0
    typeObjet: 0
  - "Id\xC9l\xE9ment": 5
    type: 0
    phrase: "je suis un h\xE9ro et un yo-kai, ah, ah !"
    quiJeSuis: 3
    nom: 
    image: {fileID: 0}
    "quantit\xE9e": 0
    typeObjet: 0
  - "Id\xC9l\xE9ment": 0
    type: 0
    phrase: La il manque juste le nom
    quiJeSuis: 0
    nom: 
