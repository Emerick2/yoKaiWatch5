              <instance_material symbol="DefaultLib.Scene_Material" target="#DefaultLib.Scene_Material" />
            </technique_common>
          </bind_material>
        </instance_controller>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene" />
  </scene>
</COLLADA>